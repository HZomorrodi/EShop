@using EShop.ViewModels.Account
@model RegisterViewModel;
<form   id="registerForm" method="post">
	<div asp-validation-summary="All" class="text-danger" id="validationErrors"></div>
	<div class="my-3">
		<label asp-for="UserName" class="form-label"></label>
		<input asp-for="UserName" class="form-control" id="userNameRegister">
		<span asp-validation-for="UserName" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="Email" class="form-label"></label>
		<input asp-for="Email" class="form-control" id="emailRegister">
		<span asp-validation-for="Email" class="text-danger"></span>
		<div id="emailHelp" class="form-text">
			ما به شما اطمینان میدهیم که ایمیل شما را با کسی به اشتراک نخواهیم گذاشت
		</div>
	</div>
	<div class="mb-3">
		<label asp-for="Password" class="form-label"></label>
		<input asp-for="Password" class="form-control" id="passwordRegister">
		<span asp-validation-for="Password" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="ConfirmPassword" class="form-label"></label>
		<input asp-for="ConfirmPassword" class="form-control" id="confirmPasswordRegister">
		<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary" id="registerBtn">ثبت نام</button>

	<div class="spinner-border me-4" role="status" id="spinner" style="display:none">
		<span class="visually-hidden">Loading...</span>
	</div>


	<p class="mt-3 alert alert-success d-none">
		ثبت نام شما با موفقیت انجام شد.
		لطفا برای فعال سازی حساب کاربری خود ایمیل ارسال شده به ایمیلتان را تایید نمایید
	</p>
</form>
 
