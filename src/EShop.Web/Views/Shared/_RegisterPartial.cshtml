@using EShop.ViewModels.Account
@model RegisterViewModel;
<form asp-action="Register" asp-controller="Account" id="registerForm" autocomplete="off"
	  data-ajax="true"
	  data-ajax-method="POST"
	  data-ajax-loading="#spinner"
	  data-ajax-begin="onBeginRegister"
	  data-ajax-complete="onCompleteRegister"
	  data-ajax-success="onsuccessRegister"
	  data-ajax-failure="onfailureRegister">
	<div asp-validation-summary="All" class="text-danger" id="validationErrorsRegister"></div>
	<div class="my-3">
		<label asp-for="UserName" class="form-label"></label>
		<input asp-for="UserName" class="form-control" id="userNameRegister">
		<span asp-validation-for="UserName" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="Email" class="form-label"></label>
		<input asp-for="Email" class="form-control">
		<span asp-validation-for="Email" class="text-danger"></span>
		<div id="emailHelp" class="form-text">
			ما به شما اطمینان میدهیم که ایمیل شما را با کسی به اشتراک نخواهیم گذاشت
		</div>
	</div>
	<div class="mb-3">
		<label asp-for="Password" class="form-label"></label>
		<input asp-for="Password" class="form-control" id="passwordRegister">
		<span asp-validation-for="Password" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="ConfirmPassword" class="form-label"></label>
		<input asp-for="ConfirmPassword" class="form-control">
		<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
	</div>
	<div>
	<button type="submit" class="btn btn-primary" id="registerBtn">ثبت نام</button>
	</div>
	<div class="spinner-border me-4" role="status" id="spinner" style="display:none">
		<span class="visually-hidden">Loading...</span>
	</div>

	<p class="mt-3 alert alert-success d-none">
		ثبت نام شما با موفقیت انجام شد.
		لطفا برای فعال سازی حساب کاربری خود ایمیل ارسال شده به ایمیلتان را تایید نمایید
	</p>
</form>
 
