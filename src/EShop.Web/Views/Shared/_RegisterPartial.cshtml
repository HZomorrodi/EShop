@using EShop.ViewModels.Account
@model RegisterViewModel;
<form   id="registerForm">
	<div asp-validation-summary="All" class="text-danger" id="validationErrors"></div>
	<div class="my-3">
		<label asp-for="UserName" class="form-label"></label>
		<input asp-for="UserName" class="form-control">
		<span asp-validation-for="UserName" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="Email" class="form-label"></label>
		<input asp-for="Email" class="form-control">
		<span asp-validation-for="Email" class="text-danger"></span>
		<div id="emailHelp" class="form-text">
			ما به شما اطمینان میدهیم که ایمیل شما را با کسی به اشتراک نخواهیم گذاشت
		</div>
	</div>
	<div class="mb-3">
		<label asp-for="Password" class="form-label"></label>
		<input asp-for="Password" class="form-control">
		<span asp-validation-for="Password" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="ConfirmPassword" class="form-label"></label>
		<input asp-for="ConfirmPassword" class="form-control">
		<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary" id="registerBtn">ثبت نام</button>

	<div class="spinner-border me-4" role="status" id="spinner" style="display:none">
		<span class="visually-hidden">Loading...</span>
	</div>


	<p class="mt-3 alert alert-success d-none">
		ثبت نام شما با موفقیت انجام شد.
		لطفا برای فعال سازی حساب کاربری خود ایمیل ارسال شده به ایمیلتان را تایید نمایید
	</p>
</form>
 
<script src="/lib/jquery/dist/jquery.min.js"></script>

<script>
	 $(document).ready(function() {
		$('#registerForm').submit(function(e) {

			console.log("hel")
			// Show loading spinner
			$('#spinner').show();

			$.ajax({
				url:"/Account/Register",
				method: "POST",
				data: $(this).serialize(),
				success: function(response) {
					if (response.success) {
						$('.alert-success').removeClass('d-none');
					} else {
						$('#validationErrors').html(response.errors);
					}
				},
				error: function(xhr) {
					$('#validationErrors').html(xhr.responseText);
				},
				complete: function() {
					$('#spinner').hide();
				}
			});
		});
	});
</script>
<script>
		$(document).ready(function() {
		$('#registerBtn').click(function() {
			// 1. Collect all form data manually
			var formData = {
				UserName: $('#userName').val(),
				Email: $('#email').val(),
				Password: $('#password').val(),
				ConfirmPassword: $('#confirmPassword').val()
			};

			// 2. Client-side validation
			if (!formData.UserName || !formData.Email || !formData.Password) {
				$('#validationErrors').text("Please fill all required fields");
				return;
			}

			// 3. Send as JSON
			$.ajax({
				url: '/Account/Register',
				type: 'POST',
				contentType: 'application/json',
				data: JSON.stringify(formData),
				success: function(response) {
					if (response.success) {
						$('.alert-success').removeClass('d-none');
					}
				},
				error: function(xhr) {
					// Handle server validation errors
					if (xhr.status === 400) {
						const errors = xhr.responseJSON;
						let errorHtml = '';
						for (let key in errors) {
							errorHtml += `<li>${errors[key]}</li>`;
						}
						$('#validationErrors').html(`<ul>${errorHtml}</ul>`);
					}
				}
			});
		});
	});
</script>