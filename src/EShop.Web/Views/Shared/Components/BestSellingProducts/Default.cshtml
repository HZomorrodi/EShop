@using EShop.ViewModels.Products
@model List<ProductPreviewViewModel>;
<h1 class="text-center my-3">پرفروش‌‌ترین محصولات</h1>

<div class="row mx-auto my-auto justify-content-center">
	<div id="recipeCarousel3" class="carousel slide" data-bs-ride="carousel">
		<div class="carousel-inner" role="listbox">
			@for (int i = 0; i < Model.Count; i++)
			{
				<div class="carousel-item @(i == 0 ? " active " : "")">
					<div class="col-md-3">
						<a asp-controller="Product" asp-action="Details" asp-route-id="@Model[i].Id" asp-route-title="@Model[i].Title" class="text-decoration-none">
							<div class="card">
								<div class="card-img">
									<img src="/images/products/@Model[i].Image" class="img-fluid">
								</div>
								<div class="card-img-overlay">@Model[i].Title</div>
							</div>
						</a>
					</div>
				</div>
			}

		</div>
		<a class="carousel-control-prev bg-transparent w-aut" href="#recipeCarousel3" role="button" data-bs-slide="prev">
			<span class="carousel-control-prev-icon" aria-hidden="true"></span>
		</a>
		<a class="carousel-control-next bg-transparent w-aut" href="#recipeCarousel3" role="button" data-bs-slide="next">
			<span class="carousel-control-next-icon" aria-hidden="true"></span>
		</a>
	</div>
</div>

