@using EShop.ViewModels.Account
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - EShop.Web</title>
	<script type="importmap"></script>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://getbootstrap.com/docs/5.3/assets/css/docs.css" rel="stylesheet">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" rel="stylesheet"> <!-- Font Awesome CSS -->
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/EShop.Web.styles.css" asp-append-version="true" />
	@await RenderSectionAsync("Csss", required: false)
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-lg bg-body-tertiary">  
			<div class="container-fluid">
				<a class="navbar-brand" href="#">
					<img src="/images/application/National Exchange.svg" alt="brand" width="30" height="24">
					فروشگاه اینترنتی
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse justify-content-between" id="navbarSupportedContent">
					<div class="navbar-nav d-flex align-items-start align-items-lg-start my-2 my-lg-0 ">
						<a class="nav-link" href="#">خانه</a>
						<form class="d-flex" role="search">
							<input class="form-control" type="search" placeholder="جستجو" aria-label="Search">
							<button class="btn btn-outline-success" type="submit">جستجو</button>
						</form>
					</div>
					<ul class="navbar-nav mb-2 mb-lg-0">
						<li class="nav-item">
							<button class="btn btn-primary mx-0 mx-lg-2" data-bs-toggle="offcanvas" data-bs-target="#offcanvasCart" aria-controls="offcanvasCart">
								سبد خرید شما
								<span class="me-2 ms-2">
									<i class="fas fa-shopping-cart"></i>
								</span>
								<span class="ms-2">(0)</span>
							</button>
						</li>
						<li class="nav-item my-2 my-lg-0">
							<button class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#loginModal">ورود/ ثبت نام</button>
						</li>
					</ul>
				</div>
			</div>
		</nav>
	</header>

	<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header  ">
					<h5 class="modal-title" id="loginModalLabel">ورود/ ثبت نام</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<!-- Tab navigation -->
					<ul class="nav nav-tabs" id="myTab" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login-tab-pane" type="button" role="tab" aria-controls="login-tab-pane" aria-selected="true">ورود</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="signup-tab" data-bs-toggle="tab" data-bs-target="#signup-tab-pane" type="button" role="tab" aria-controls="signup-tab-pane" aria-selected="false">ثبت نام</button>
						</li>
					</ul>
					<!-- Tab content -->
					<div class="tab-content" id="myTabContent">
						<div class="tab-pane fade show active" id="login-tab-pane" role="tabpanel" aria-labelledby="login-tab" tabindex="0">
							<!-- Login Form -->
							<form>
								<div class="mb-3">
									<label for="email" class="form-label">ایمیل</label>
									<input type="email" dir="rtl" class="form-control" id="email" placeholder="ایمیل خود را وارد کنید">
								</div>
								<div class="mb-3">
									<label for="password" class="form-label">رمز عبور</label>
									<input type="password" class="form-control" id="password" placeholder="رمز عبور خود را وارد کنید">
								</div>
								<div class=" mb-3">
									<input type="checkbox" id="Remember" class="form-check-input" />
									<label for="Remember" class="form-check-label">مرا به خاطر بسپار</label>
								</div>
								<button type="submit" class="btn btn-primary">ورود</button>
							</form>
						</div>
						<div class="tab-pane fade" id="signup-tab-pane" role="tabpanel" aria-labelledby="signup-tab" tabindex="0">
							<!-- Signup Form -->
							<partial name="_RegisterPartial" model="new RegisterViewModel()" />
							@* @await Component.InvokeAsync("RegistrationModal") *@

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCart" aria-labelledby="offcanvasCartLabel">
		<div class="offcanvas-header">
			<h5 id="offcanvasCartLabel">سبد خرید شما</h5>
			<button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
		</div>
		<div class="offcanvas-body">
			<p class="text-center fs-3">جمع کل سبد خرید</p>
			<div class="d-flex justify-content-around align-items-center mb-3">
				<h3 class=" ">215000 تومان</h3>
				<button class="btn btn-success">
					تسویه حساب
					<span class="mx-1">
						<i class="fas fa-shopping-basket"></i>
					</span>
				</button>
			</div>
			<div class="row">
				<div class="col-6 mb-3">
					<div class="card">
						<img src="https://picsum.photos/150" class="card-img-top" alt="...">
						<div class="card-body">
							<h5 class="card-title">گوشی موبایل سامسونگ s1</h5>
							<div class="d-flex justify-content-center align-items-center">
								<button class="btn btn-outline-secondary btn-sm plus-btn">+</button>
								<span class="count mx-3 bg-secondary py-1 px-3 rounded ">1</span>
								<button class="btn btn-outline-secondary btn-sm minus-btn">-</button>
							</div>
							<div class="mt-2 text-center">
								<p>قیمت واحد</p>
								<p>100 هزار تومان</p>
								<hr>
								<p>قیمت کل</p>
								<p class="total-price">500 هزار تومان</p>
							</div>
						</div>
					</div>
				</div>
				<div class="col-6 mb-3">
					<div class="card">
						<img src="https://picsum.photos/150" class="card-img-top" alt="...">
						<div class="card-body">
							<h5 class="card-title">گوشی موبایل سامسونگ s1</h5>
							<div class="d-flex justify-content-center align-items-center">
								<button class="btn btn-outline-secondary btn-sm plus-btn">+</button>
								<span class="count mx-3 bg-secondary py-1 px-3 rounded ">1</span>
								<button class="btn btn-outline-secondary btn-sm minus-btn">-</button>
							</div>
							<div class="mt-2 text-center">
								<p>قیمت واحد</p>
								<p>100 هزار تومان</p>
								<hr>
								<p>قیمت کل</p>
								<p class="total-price">500 هزار تومان</p>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-6 mb-3">
					<div class="card">
						<img src="https://picsum.photos/150" class="card-img-top" alt="...">
						<div class="card-body">
							<h5 class="card-title">گوشی موبایل سامسونگ s1</h5>
							<div class="d-flex justify-content-center align-items-center">
								<button class="btn btn-outline-secondary btn-sm plus-btn">+</button>
								<span class="count mx-3 bg-secondary py-1 px-3 rounded ">1</span>
								<button class="btn btn-outline-secondary btn-sm minus-btn">-</button>
							</div>
							<div class="mt-2 text-center">
								<p>قیمت واحد</p>
								<p>100 هزار تومان</p>
								<hr>
								<p>قیمت کل</p>
								<p class="total-price">500 هزار تومان</p>
							</div>
						</div>
					</div>
				</div>
				<div class="col-6 mb-3">
					<div class="card">
						<img src="https://picsum.photos/150" class="card-img-top" alt="...">
						<div class="card-body">
							<h5 class="card-title">گوشی موبایل سامسونگ s1</h5>
							<div class="d-flex justify-content-center align-items-center">
								<button class="btn btn-outline-secondary btn-sm plus-btn">+</button>
								<span class="count mx-3 bg-secondary py-1 px-3 rounded ">1</span>
								<button class="btn btn-outline-secondary btn-sm minus-btn">-</button>
							</div>
							<div class="mt-2 text-center">
								<p>قیمت واحد</p>
								<p>100 هزار تومان</p>
								<hr>
								<p>قیمت کل</p>
								<p class="total-price">500 هزار تومان</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2024 - EShop.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

	<script src="~/js/site.js" asp-append-version="true"></script>
 
	<partial name="_ValidationScriptsPartial" />

	<script>
		 $(document).ready(function() {
			$('#registerForm').submit(function(e) {
				e.preventDefault()
				console.log("hel")
				// Show loading spinner
				$('#spinner').show();

				$.ajax({
					url:"/Account/Register",
					method: "POST",
					data: $(this).serialize(),
					success: function(response) {
						if (response=="Success") {
							$('.alert-success').removeClass('d-none');
						//	 $('#loginModal').modal('hide');
						} else {
							$('#validationErrors').html(response.errors);
						}
					},
					error: function(xhr) {
						$('#validationErrors').html(xhr.responseText);
					},
					complete: function() {
						$('#spinner').hide();
					}
				});
			});
		});
	</script>
