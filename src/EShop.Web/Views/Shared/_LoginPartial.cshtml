@using EShop.ViewModels.Account
@model LoginViewModel;
<form asp-action="NaveBarLogin" asp-controller="Account" id="loginrForm" autocomplete="off"
	  data-ajax="true"
	  data-ajax-method="POST"
	  data-ajax-loading="#spinner"
	  data-ajax-begin="onBeginLogin"
	  data-ajax-complete="onCompleteLogin"
	  data-ajax-success="onsuccessLogin"
	  data-ajax-failure="onfailureLogin">
	<div asp-validation-summary="All" class="text-danger" id="validationErrorsLogin"></div>
	<div class="my-3">
		<label asp-for="UserName" class="form-label"></label>
		<input asp-for="UserName" class="form-control" id="userNameLogin">
		<span asp-validation-for="UserName" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="Password" class="form-label"></label>
		<input asp-for="Password" class="form-control" id="passwordLogin">
		<span asp-validation-for="Password" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<input type="checkbox" class="form-check-input" asp-for="RememberMe">
		<label class="form-check-label" asp-for="RememberMe"></label>
	</div>

	<button type="submit" class="btn btn-primary" id="loginBtn">ورود</button>

	<div class="spinner-border me-4" role="status" id="spinner" style="display:none">
		<span class="visually-hidden">Loading...</span>
	</div>


	<p class="mt-3 alert alert-success d-none">
		ورود شما با موفقیت انجام شد.
	 <br />
	 در حال انتقال ...
	</p>
</form>

