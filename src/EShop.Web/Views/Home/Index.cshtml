@{
	ViewData["Title"] = "Home Page";
}
@section Csss{
	<style>

		.content-block {
			padding: 00px;
			background-color: #f8f9fa;
			border: 1px solid #dee2e6;
			margin-top: 10px;
		}

		/* Styles for the Second carousel */
		@@media (max-width: 767px) {
			#recipeCarousel2 .carousel-inner .carousel-item > div {
				display: none;
			}

				#recipeCarousel2 .carousel-inner .carousel-item > div:first-child {
					display: block;
				}
		}

		#recipeCarousel2
		.carousel-inner .carousel-item.active,
		.carousel-inner .carousel-item-next,
		.carousel-inner .carousel-item-prev {
			display: flex;
		}

		/* medium and up screens */
		@@media (min-width: 768px) {
			#recipeCarousel2 .carousel-inner .carousel-item-end.active, .carousel-inner .carousel-item-next {
				transform: translateX(25%);
			}

			#recipeCarousel2
			.carousel-inner .carousel-item-start.active,
			.carousel-inner .carousel-item-prev {
				transform: translateX(-25%);
			}
		}

		#recipeCarousel2
		.carousel-inner .carousel-item-end,
		.carousel-inner .carousel-item-start {
			transform: translateX(0);
		}

		/* Styles for the third carousel */
		@@media (max-width: 767px) {
			#recipeCarousel3 .carousel-inner .carousel-item > div {
				display: none;
			}

				#recipeCarousel3 .carousel-inner .carousel-item > div:first-child {
					display: block;
				}
		}

		#recipeCarousel3
		.carousel-inner .carousel-item.active,
		.carousel-inner .carousel-item-next,
		.carousel-inner .carousel-item-prev {
			display: flex;
		}

		/* medium and up screens */
		@@media (min-width: 768px) {
			#recipeCarousel3 .carousel-inner .carousel-item-end.active, .carousel-inner .carousel-item-next {
				transform: translateX(25%);
			}

			#recipeCarousel3
			.carousel-inner .carousel-item-start.active,
			.carousel-inner .carousel-item-prev {
				transform: translateX(-25%);
			}
		}

		#recipeCarousel3
		.carousel-inner .carousel-item-end,
		.carousel-inner .carousel-item-start {
			transform: translateX(0);
		}
	</style>
}

