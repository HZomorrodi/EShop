@using EShop.ViewModels.Categories
@model List<CategoryAllFields>
@{
    ViewData["Title"] = "Home Page";
}
@section Csss {
    <style>

         
    </style>
}

<div class="container-fluid">
    <div class="row mt-4">
        <div class="col-lg-8 content-block ms-lg-auto">
            <!-- Right Block Content with Carousel -->
            <vc:slider></vc:slider>
        </div>
        <div class="col-lg-3 content-block">
            <!-- Left Block Content -->
            <div class="accordion" id="accordionExample">
                @{
                    var counter = 1;
                }
                @foreach (var item in Model)
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading@(counter)">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@(counter)" aria-expanded="true" aria-controls="collapse@(counter)">
                                @item.Title
                            </button>
                        </h2>
                        <div id="collapse@(counter)" class="accordion-collapse collapse" data-bs-parent="#accordionExample" aria-labelledby="heading@(counter++)">
                            <div class="accordion-body">
                                <ul class="list-group" id="admin-main-menus">
                                    @foreach (var subCat in item.Children)
                                    {
                                        <li class="list-group-item">
                                            <a class="dropdown-item" asp-action="Index" asp-controller="Product" asp-area="" asp-route-selectedCategories="@subCat.Id">
                                                @subCat.Title
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

