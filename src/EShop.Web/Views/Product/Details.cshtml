@using System.Net
@model EShop.ViewModels.Products.ProductDetailsViewModel;

@{
	ViewData["Title"] = $"جزییات محصول {Model.Title}";
}
@section Tags {
	@if (Model.Tags != null)
	{
		<meta name="keywords" content="@string.Join(",", Model.Tags)" />
	}
}
<div class="container">
	<div class="row">
		<div class="col-md-4">
			<img id="main-product-image" src="/images/products/@Model.Images.First()" class="img-thumbnail" alt="@Model.Title" style="width: 100%" />
			@foreach (var image in Model.Images)
			{
				<img src="/images/products/@image" class="img-thumbnail subImage" width="100" style="cursor: pointer" />
			}
		</div>
		<div class="col-md-8">
			<h3>
				@Model.Title
			</h3>
			<hr />
			<p>
				ویژگی های محصول
			</p>
			@foreach (var property in Model.Properties)
			{
				var splittedProperty = property.Split("|||", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
				<p>
					@splittedProperty[0]
					:
					@splittedProperty[1]
				</p>
			}
			<hr />
			<h2>
				@Model.Price.ToString("#,0")
				تومان
			</h2>
			<br />
			<form method="post">
				<button type="button" id="add-to-cart-button" class="btn btn-outline-success btn-lg mb-3">
					<i class="bi bi-cart-check-fill"></i>
					<span>افزودن به سبد خرید</span>
					<img class="d-none" width="20" src="/images/application/loading.gif" alt="صبر کنید" />
				</button>
			</form>
			<div>
				@Html.Raw(Model.Description)
				@Model.Description
			</div>
		</div>
	</div>
	<br />
	<div>
		<vc:newest-products exclude-id="@Model.Id"></vc:newest-products>
	</div>
	<div class="toast-container position-fixed bottom-0 start-0 p-3">
		<div id="myToastEl" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
			<div class="toast-header">
				<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
			</div>
			<div class="toast-body"></div>

		</div>
	</div>
</div>

@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>

	<script>
		// Handle sub-image click to change main product image
		$('.subImage').on('click', function() {
			$('#main-product-image').attr("src", $(this).attr("src"));
		});

		// Handle add to cart button click
		$('#add-to-cart-button').on('click', function() {
			$.ajax({
				url: '/Cart/Add',
				type: 'POST',
				data: {
					productId: @Model.Id,
					__RequestVerificationToken: $('form input[name="__RequestVerificationToken"]').val()
				},
				beforeSend: function() {
					if (!isUserAuthenticated) {
						showToast('ابتدا وارد سایت شوید', 'bg-danger');
						return false;
					}

					$('#add-to-cart-button span').text('در حال افزودن...');
					$('#add-to-cart-button img').removeClass('d-none');
					$('#add-to-cart-button').prop('disabled', true); // Prevent double clicks
				},
				success: function(data) {
					showToast('محصول مورد نظر با موفقیت به سبد خرید اضافه شد', 'bg-success');
					$('[data-bs-target="#offcanvasCart"] span').eq(1).text(`(${data})`);
					getCardDetails();
				},
				error: function(xhr, status, error) {
					showToast("خطا در افزودن به سبد خرید: " + error, 'bg-danger');
				},
				complete: function() {
					$('#add-to-cart-button span').text('افزودن به سبد خرید');
					$('#add-to-cart-button img').addClass('d-none');
					$('#add-to-cart-button').prop('disabled', false); // Re-enable button
				}
			});
		});

		// Show toast notification
		function showToast(message, bgClass) {
			const toast = $('#myToastEl');
			toast.addClass(bgClass);
			toast.find('.toast-body').text(message);
			bootstrap.Toast.getOrCreateInstance(toast).show();
		}
	</script>
}
