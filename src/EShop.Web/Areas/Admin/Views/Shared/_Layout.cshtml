<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <title>@ViewData["Title"] - EShop.Web</title>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EShop.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Csss", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-black">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link active" href="#">پنل مدیریت</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">مشاهده سایت</a></li>
                </ul>
                <ul class="navbar-nav pe-0">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <img src="https://picsum.photos/200/200?random=1" alt="پروفایل" class="profile-img">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">سلام<br>محمد رضایی</h6></li>
                            <li><a class="dropdown-item" href="#">ویرایش پروفایل</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#">خروج</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Right Sidebar (3 columns) -->
            <div class="col-lg-3 sidebar">
                <h4 class="mb-4">منوی مدیریت</h4>
                <ul class="nav flex-column">
                    <li class="nav-item dropdown mb-2">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">داشبورد</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">داشبورد اصلی</a></li>
                            <li><a class="dropdown-item" href="#">داشبورد مالی</a></li>
                            <li><a class="dropdown-item" href="#">داشبورد کاربران</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown mb-2">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">مدیریت کاربران</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">لیست کاربران</a></li>
                            <li><a class="dropdown-item" href="#">افزودن کاربر جدید</a></li>
                            <li><a class="dropdown-item" href="#">سطوح دسترسی</a></li>
                            <li><a class="dropdown-item" href="#">گروه‌های کاربری</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown mb-2">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">تنظیمات سیستم</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">تنظیمات عمومی</a></li>
                            <li><a class="dropdown-item" href="#">تنظیمات امنیتی</a></li>
                            <li><a class="dropdown-item" href="#">پیکربندی ماژول‌ها</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown mb-2">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">گزارشات آماری</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">گزارشات کاربران</a></li>
                            <li><a class="dropdown-item" href="#">گزارشات مالی</a></li>
                            <li><a class="dropdown-item" href="#">گزارشات ترافیک</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#">گزارشات سفارشی</a></li>
                        </ul>
                    </li>
                </ul>
            </div>

            <!-- Main Content (9 columns) -->
            <div class="col-lg-9 main-content">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>