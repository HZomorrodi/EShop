@model EShop.ViewModels.Products.EditProductViewModel

@{
    var df = Model;
    ViewData["Title"] = "ویرایش محصول";
}

<h3>
    @ViewData["Title"]
    <br />
    <a asp-action="Index" class="mt-3 btn btn-outline-info">بازگشت به محصولات</a>
</h3>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit" enctype="multipart/form-data" id="edit-product-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" />
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" id="product-description"></textarea>
                <span asp-validation-for="Description" class="text-danger" id="product-description-error-message"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId" class="control-label"></label>
                <select asp-for="CategoryId" asp-items="@ViewBag.MainCategories" id="main-categories-element" class="form-control"></select>
            </div>
            <div class="form-group">
                <label asp-for="CategoryChildrenId" class="control-label"></label>
                <select asp-for="CategoryChildrenId" class="form-control" id="category-children-element"></select>
                <span asp-validation-for="CategoryChildrenId" class="text-danger"></span>
            </div>
            <div class="form-group" id="product-images-place">
                <label asp-for="Images" class="control-label"></label>
                <input asp-for="Images" class="form-control" accept="image/*" id="file-input" />
                <span asp-validation-for="Images" class="text-danger"></span>
                @foreach (var item in Model.ProductImages)
                {
                    <div>
                        <img src="/images/products/@item" width="100" class="img-thumbnail" />
                        <button type="button" class="btn btn-danger remove-image-btn">حذف</button>
                    </div>
                }
            </div>
            <div class="form-group">
                <label asp-for="Properties" class="control-label"></label>
                <input type="text" id="product-property-title" class="form-control" maxlength="100" placeholder="عنوان ویژگی" />
                <input type="text" id="product-property-value" class="form-control" maxlength="100" placeholder="مقدار ویژگی" />
                <input type="button" id="product-property-button" value="افزودن" class="my-3 btn btn-success" />
                <br />
                <div id="product-properties">
                    @foreach (var property in Model.Properties)
                    {
                        <p>
                            @Html.Encode(property)
                            <button type="button" class="btn btn-danger remove-property-btn">حذف</button>
                        </p>
                    }
                </div>
            </div>
            <div class="form-group my-3">
                <input type="submit" value="ویرایش" class="btn btn-primary" />
            </div>

            <div class="toast-container position-fixed bottom-0 start-0 p-3">
                <div id="myToastEl" class="toast bg-danger" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="toast-header">
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body"></div>

                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/ckeditor/ckeditor.js"></script>
    <script>
        $(function() {
            // CKEditor Initialization
            CKEDITOR.replace('product-description', {
                language: 'fa',
                contentsCss: ["body {font-family: 'Vazir'}"]
            });

            // Event Handlers
            $('#main-categories-element').change(loadSubCategories);

            $('#product-property-button').on('click', function() {
                const propertyTitle = $("#product-property-title");
                const propertyValue = $("#product-property-value");

                if (isNullOrWhiteSpace(propertyTitle)) {
                    showToast('لطفا عنوان ویژگی را وارد نمایید');
                    return;
                }

                if (isNullOrWhiteSpace(propertyValue)) {
                    showToast('لطفا مقدار ویژگی را وارد نمایید');
                    return;
                }

                // Create the new property element
                const newProperty = $('<p></p>')
                    .text(`${propertyTitle.val()} ||| ${propertyValue.val()} `)
                    .append(
                        $('<button></button>')
                            .addClass('btn btn-danger')
                            .text('حذف')
                            .on('click', function() {
                                $(this).parent().remove();
                            })
                    );

                // Add to DOM and clear inputs
                $("#product-properties").append(newProperty);
                propertyTitle.val('');
                propertyValue.val('');
            });

            $('#edit-product-form').on('submit', function(e) {
                e.preventDefault();
                const $form = $(this);
                const editor = CKEDITOR.instances['product-description'];
                const $errorSpan = $('#product-description-error-message');

                // 1. Validate CKEditor content
                if (!editor.getData().trim()) {
                    $errorSpan.text('لطفا توضیحات را وارد نمایید').addClass('text-danger');
                    return false;
                }
                else if ($('#product-images-place img').length === 0 && $('input[name="@Html.NameFor(x => x.Images)"]')[0]?.files?.length === 0) {
                    $('#product-images-place span').text('لطفا عکس های محصول را وارد نمایید');
                    $('#product-images-place input').focus();
                    return false;
                }
                $errorSpan.empty().removeClass('text-danger');

                // 2. Process properties securely
                $form.find('input[name="@Html.NameFor(x => x.Properties)"]').remove(); // Clear existing
                const $properties = [];

                $('#product-properties p').each(function() {
                    const text = $(this).contents().first().text().trim(); // Get text before |||
                    $properties.push(
                        $('<input/>', {
                            type: 'hidden',
                            name: '@Html.NameFor(x => x.Properties)',
                            value: text // XSS-safe via jQuery creation
                        })
                    );
                });

                $form.find('input[name="@Html.NameFor(x => x.ProductImages)"]').remove(); // Clear existing
                const $productImages = [];

                $('#product-images-place img').each(function() {
                    const src = $(this).attr("src").split('/').pop();
                    $productImages.push(
                        $('<input/>', {
                            type: 'hidden',
                            name: '@Html.NameFor(x => x.ProductImages)',
                            value: src // XSS-safe via jQuery creation
                        })
                    );
                });

                // 3. Submit handling
                $form.append([...$properties, ...$productImages]).off('submit').trigger('submit'); // Prevent recursion
            });

            // Functions
            function loadSubCategories() {
                // Clear existing options first
                $("#category-children-element").empty();
                $('#category-children-element').append(
                    $('<option></option>').val(0).text("انتخاب کنید")
                );

                var mainCategoryId = $("#main-categories-element").val();
                if (!mainCategoryId) return;  // Skip if no category selected

                $.ajax({
                    url: '/Admin/Product/GetSubCategories',
                    data: { mainCategoryId },
                    success: function(data) {
                        // Add new options
                        $.each(data, function(index, element) {
                            $('#category-children-element').append(
                                $('<option></option>')
                                    .val(element.id)
                                    .text(element.title)
                                    .prop("selected", element.id === @Model.CategoryChildrenId)
                            );
                        });
                    },
                    error: function(xhr, status, error) {
                        console.error("Error loading subcategories:", error);
                    }
                });
            }

            function showToast(message) {
                const toast = $('#myToastEl');
                toast.find('.toast-body').text(message);
                bootstrap.Toast.getOrCreateInstance(toast).show();
            }

            function isNullOrWhiteSpace(str) {
                return !str.val() || str.val().trim().length === 0;
            }

            // CKEditor Change Handler
            var editor = CKEDITOR.instances['product-description'];
            editor.on('change', function() {
                var errorSpan = $('#product-description-error-message');
                if (editor.getData().trim().length === 0) {
                    errorSpan.text('لطفا توضیحات را وارد نمایید');
                } else {
                    errorSpan.empty();
                }
            });

            $('#product-images-place input[type="file"]').on('change', validateProductImages);

            function validateProductImages() {
                const hasExistingImages = $('#product-images-place img').length > 0;
                const fileInput = $('#product-images-place input[type="file"]')[0];
                const hasNewFiles = fileInput?.files?.length > 0;
                const $errorSpan = $('#product-images-place span');

                if (!hasExistingImages && !hasNewFiles) {
                    $errorSpan.text('لطفا حداقل یک عکس برای محصول انتخاب نمایید');
                } else {
                    $errorSpan.text('');
                }
            }

            // Delegated Event Handlers
            $(document).on('click', '.remove-property-btn', function() {
                const $parent = $(this).closest('p');
                const property = $parent.data('property'); // Optional: access encoded data
                $parent.remove();
            });

            $(document).on('click', '.remove-image-btn', function() {
                const $button = $(this);
                const $img = $button.siblings('img');
                const imageSrc = $img.attr("src");
                const imageName = imageSrc.split('/').pop();

                $.ajax({
                    url: '/Admin/Product/RemoveProductPicture',
                    type: 'POST',
                    data: {
                        imageName,
                       __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function() {
                        $button.closest('div').remove();
                        validateProductImages();
                        showToast('تصویر با موفقیت حذف شد');
                    },
                    error: function(xhr, status, error) {
                        console.error("Error deleting image:", error);
                        showToast('خطا در حذف تصویر');
                    }
                });
            });

            // Initial Load
            loadSubCategories();
        });
    </script>
}